
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppConfig {
  id                    String @id @default("singleton")
  achievementCapPercent Float  @default(120)
  // Dashboard rating thresholds in percent: { outstanding, veryGood, good, fair }.
  // Null = the Excel legend (90 / 80 / 70 / 50).
  ratingBands           Json?

  updatedAt DateTime @updatedAt
}

model RolePermission {
  id         String @id @default(cuid())
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId     String
  permission String

  createdAt DateTime @default(now())

  @@unique([roleId, permission])
}

model Role {
  id       String @id @default(cuid())
  name     String @unique
  isSystem Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StrategicPlan {
  id        String    @id @default(cuid())
  name      String
  startYear Int
  endYear   Int
  version   String
  status    PlanStatus @default(DRAFT)
  pillars   Pillar[]
  activities Activity[]
  reportingPeriods ReportingPeriod[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ReportingPeriod {
  id              String                @id @default(cuid())
  strategicPlan   StrategicPlan         @relation(fields: [strategicPlanId], references: [id], onDelete: Cascade)
  strategicPlanId String
  name            String
  startDate       DateTime
  endDate         DateTime
  cutOffDate      DateTime
  status          ReportingPeriodStatus @default(OPEN)
  activities      Activity[]
  notifications   Notification[]
  periodEntries   ActivityPeriodEntry[]

  // The report request sent to activity owners for this period.
  reportRequestMessage  String?
  reportRequestSentAt   DateTime?
  reportRequestSentById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([strategicPlanId, name])
}

model Pillar {
  id              String         @id @default(cuid())
  title           String
  description     String?
  strategicPlan   StrategicPlan? @relation(fields: [strategicPlanId], references: [id], onDelete: Cascade)
  strategicPlanId String?
  objectives      Objective[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Objective {
  id          String      @id @default(cuid())
  statement   String
  pillar      Pillar      @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  pillarId    String
  initiatives Initiative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Initiative {
  id            String     @id @default(cuid())
  title         String
  description   String?
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId       String
  collaborators String[]
  coOwners      String[]   @default([])
  objective     Objective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  objectiveId   String
  isContinuous  Boolean    @default(false)
  activities    Activity[]
  milestones    Milestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Milestone {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  title        String
  targetDate   DateTime
  isAchieved   Boolean    @default(false)
  achievedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([initiativeId])
}

/// An office that leads activities in the plan, e.g. "Chief Strategy Officer"
/// (the Excel's "Lead/ Owner (Activity)" column).
model LeadOwner {
  id         String  @id @default(cuid())
  name       String  @unique
  department String?
  users      User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id              String         @id @default(cuid())
  title           String
  description     String?
  department      String
  // The lead-owner office for this activity, kept as written so the plan
  // shows it even if the office list changes later.
  leadOwner       String?
  responsible     User           @relation(fields: [responsibleId], references: [id])
  responsibleId   String
  startDate       DateTime
  endDate         DateTime
  status          String
  weight          Float
  progress        Float
  updates         Json[]
  pendingUpdate   Json?
  approvalStatus  ApprovalStatus @default(PENDING)
  declineReason   String?
  initiative      Initiative     @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId    String
  strategicPlan   StrategicPlan? @relation(fields: [strategicPlanId], references: [id])
  strategicPlanId String?
  reportingPeriod   ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id], onDelete: SetNull)
  reportingPeriodId String?
  kpis            Kpi[]
  completionDate  DateTime?
  delayExplanation String?
  recommendedAction String?
  evidence        Evidence[]
  notifications   Notification[]
  deliverables    Deliverable[]
  duplicateGroupId   String?
  countsTowardWeight Boolean               @default(true)
  periodEntries      ActivityPeriodEntry[]

  planRequestStatus       PlanRequestStatus @default(NOT_SENT)
  planRequestSentAt       DateTime?
  planRequestSentById     String?
  planRequestRespondedAt  DateTime?
  planRequestDeclineReason String?

  // Monthly breakdown filled in by the responsible person once they accept
  // the plan request. planSubmissionStatus null = not submitted yet.
  deliverable             String?
  targetType              TargetType?
  // CUMULATIVE: months add up to the target (Excel =SUM). RECURRING: each
  // month is a level to hold, e.g. "80% every month" (Excel =MAX).
  targetAggregation       TargetAggregation @default(CUMULATIVE)
  // LOWER_IS_BETTER targets (e.g. a cost ratio) score Plan ÷ Actual instead of Actual ÷ Plan.
  targetDirection         KpiDirection      @default(HIGHER_IS_BETTER)
  annualTarget            Float?
  monthlyTargets          ActivityMonthlyTarget[]
  proposedByOwner         Boolean         @default(false)
  planSubmissionStatus    ApprovalStatus?
  planDeclineReason       String?
  planSubmittedById       String?
  planSubmittedAt         DateTime?
  planApprovedById        String?
  planApprovedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([duplicateGroupId])
}

model ActivityPeriodEntry {
  id                String          @id @default(cuid())
  activity          Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId        String
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  reportingPeriodId String

  plannedProgress       Float   @default(0)
  actualProgress        Float?
  pendingActualProgress Float?

  // Period report (the Excel's blue columns), in the activity's target units.
  // planToDate is snapshotted from the approved monthly breakdown when the
  // request is sent; comment holds "Accomplished tasks & key achievements".
  reportStatus       PeriodReportStatus @default(NOT_REQUESTED)
  reportRequestedAt  DateTime?
  planToDate         Float?
  actualToDate       Float?
  completionDate     DateTime?

  comment            String?
  reasonForVariation String?
  wayForward         String?
  escalationIssues   String?

  approvalStatus ApprovalStatus @default(PENDING)
  declineReason  String?
  submittedById  String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence Evidence[]

  @@unique([activityId, reportingPeriodId])
  @@index([activityId])
  @@index([reportingPeriodId])
}

model ActivityMonthlyTarget {
  id         String   @id @default(cuid())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  // First day of the month (UTC) this target belongs to.
  month      DateTime
  value      Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityId, month])
  @@index([activityId])
}

model Deliverable {
  id            String    @id @default(cuid())
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId    String
  title         String
  description   String?
  dueDate       DateTime?
  isDelivered   Boolean   @default(false)
  deliveredDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
}

model Evidence {
  id           String   @id @default(cuid())
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId   String
  // The period report this file supports. Null only for files uploaded before evidence moved onto reports.
  periodEntry   ActivityPeriodEntry? @relation(fields: [periodEntryId], references: [id], onDelete: Cascade)
  periodEntryId String?
  fileName     String
  mimeType     String
  fileSize     Int
  data         Bytes
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([activityId])
  @@index([periodEntryId])
}

model Kpi {
  id         String       @id @default(cuid())
  activity   Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  name       String
  unit       String?
  target     Float?
  actual     Float?
  hasTarget  Boolean      @default(true)
  direction  KpiDirection @default(HIGHER_IS_BETTER)
  weight     Float        @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  avatar         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  roleId         String
  status         UserStatus
  passwordHash   String       @default("")
  sessionVersion Int          @default(0)
  /// Null until the user signs in for the first time; while null an admin can resend the invite.
  lastLoginAt    DateTime?
  passwordTokens PasswordToken[]
  notifications  Notification[]
  activities     Activity[]
  sessions       ActiveSession[]
  uploadedEvidence Evidence[]
  ownedInitiatives Initiative[]
  // The office this person holds (e.g. "Chief Strategy Officer") and their
  // department. Both optional; used to match plan lead owners to people.
  leadOwner        LeadOwner?   @relation(fields: [leadOwnerId], references: [id], onDelete: SetNull)
  leadOwnerId      String?
  department       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActiveSession {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  ip            String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  revokedAt     DateTime?
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id              String        @id @default(cuid())
  session         ActiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId       String
  tokenHash       String        @unique
  familyId        String
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?

  @@index([sessionId])
  @@index([familyId])
}

enum PasswordTokenPurpose {
  INVITE
  RESET
}

/// Single-use link for setting a password: the invite sent on registration, or a forgot-password reset.
/// Only a SHA-256 hash of the token is stored; the raw token lives in the emailed link.
model PasswordToken {
  id        String               @id @default(cuid())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, purpose])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  identifier String?
  userId     String?
  ip         String?
  userAgent  String?
  success    Boolean
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
}

model Notification {
  id      String   @id @default(cuid())
  type    String   @default("GENERAL")
  message String
  date    DateTime
  read    Boolean
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String?
  reportingPeriod   ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  reportingPeriodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rule {
  id          String  @id @default(cuid())
  status      String  @unique
  description String
  min         Float
  max         Float
  isSystem    Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PlanStatus {
    DRAFT
    PUBLISHED
}

enum ApprovalStatus {
    PENDING
    APPROVED
    DECLINED
}

enum ReportingPeriodStatus {
    OPEN
    CLOSED
}

enum PlanRequestStatus {
    NOT_SENT
    SENT
    ACCEPTED
    DECLINED
}

enum PeriodReportStatus {
    NOT_REQUESTED
    REQUESTED
    SUBMITTED
    APPROVED
    RETURNED
}

enum TargetAggregation {
    CUMULATIVE
    RECURRING
}

enum TargetType {
    PERCENT
    NUMBER
}

enum KpiDirection {
    HIGHER_IS_BETTER
    LOWER_IS_BETTER
}
