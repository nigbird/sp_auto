# OpenTelemetry: the app sends traces, metrics and logs to the OpenTelemetry Collector
# agent on this server, which forwards them to Grafana. Copy these lines into the .env
# (or .env.production) that `npm start` reads on the server. Never put the gateway
# address or a token here.
# Windows server: use 127.0.0.1, never localhost (Node may resolve it to IPv6 ::1,
# where the agent does not listen).
OTEL_SERVICE_NAME=strategic-plan-automation
# deployment.environment.name must be exactly dev, staging or prod (match the server)
OTEL_RESOURCE_ATTRIBUTES=service.namespace=pmo,service.version=0.1.0,deployment.environment.name=<dev|staging|prod>
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_METRIC_EXPORT_TIMEOUT=10000
